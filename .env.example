# Application
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/cultureplusbenin

# Auth (JWT)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# RAG / chatbot culturel
OPENAI_API_KEY=your-openai-api-key
# Embeddings (GLOBAL, pas par requête) : 'openai' (text-embedding-3-small) ou
# 'gemini' (gemini-embedding-001, tronqué à 1536 dims pour l'index Atlas).
# ATTENTION : après un changement, réindexer toutes les sources
# (POST /rag/admin/reindex/:sourceType), sinon la recherche mélange deux
# espaces vectoriels incompatibles.
RAG_EMBEDDINGS_PROVIDER=openai
#RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
#RAG_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Génération des réponses : provider par défaut quand la requête ne précise
# rien ('openai' ou 'gemini') — chaque requête POST /rag/chat peut aussi passer
# son propre "llmProvider". Gemini nécessite GOOGLE_API_KEY (Google AI Studio).
RAG_LLM_PROVIDER=openai
#RAG_OPENAI_MODEL=gpt-4o-mini
#RAG_GEMINI_MODEL=gemini-2.5-flash
#GOOGLE_API_KEY=your-google-ai-studio-key

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
